  "sentences": [
    {
      "id": "s1",
      "es": "Luis y Pepe son primos.",
      "zh": "路易斯和佩佩是表兄弟。",
      "audio": "audio/s1.m4a",
      "audioSlow": "audio/s1-slow.m4a"
    },
    {
      "id": "s2",
      "es": "Luis es moreno y Pepe es rubio.",
      "zh": "路易斯皮肤黝黑，佩佩是金发。",
      "audio": "audio/s2.m4a",
      "audioSlow": "audio/s2-slow.m4a"
    },
    {
      "id": "s3",
      "es": "Estudian en la universidad.",
      "zh": "他们在大学学习。",
      "audio": "audio/s3.m4a",
      "audioSlow": "audio/s3-slow.m4a"
    },
    {
      "id": "s4",
      "es": "Ahora van a la facultad. Van a hablar con sus profesores.",
      "zh": "现在他们去学院。他们要去和老师谈话。",
      "audio": "audio/s4.m4a",
      "audioSlow": "audio/s4-slow.m4a"
    },
    {
      "id": "s5",
      "es": "Manolo es el padre de Luis. Es mecánico.",
      "zh": "马诺罗是路易斯的爸爸。他是机械师。",
      "audio": "audio/s5.m4a",
      "audioSlow": "audio/s5-slow.m4a"
    },
    {
      "id": "s6",
      "es": "Trabaja en una fábrica muy grande. La fábrica está lejos de la ciudad.",
      "zh": "他在一家很大的工厂工作。工厂离城市很远。",
      "audio": "audio/s6.m4a",
      "audioSlow": "audio/s6-slow.m4a"
    },
    {
      "id": "s7",
      "es": "Hoy es domingo. Manolo no trabaja; descansa en casa.",
      "zh": "今天是星期天。马诺罗不工作，在家休息。",
      "audio": "audio/s7.m4a",
      "audioSlow": "audio/s7-slow.m4a"
    },
    {
      "id": "s8",
      "es": "Ema es la madre de Luis. Es enfermera. Trabaja en un hospital pequeño.",
      "zh": "埃玛是路易斯的妈妈。她是护士，在一家小医院工作。",
      "audio": "audio/s8.m4a",
      "audioSlow": "audio/s8-slow.m4a"
    },
    {
      "id": "s9",
      "es": "Ahora está en el mercado. Compra comidas para la familia.",
      "zh": "现在她在市场。她在为家人买食品。",
      "audio": "audio/s9.m4a",
      "audioSlow": "audio/s9-slow.m4a"
    },
    {
      "id": "s10",
      "es": "¿Cómo son Luis y Pepe? — Luis es moreno y Pepe es rubio.",
      "zh": "路易斯和佩佩长得怎么样？——路易斯皮肤黝黑，佩佩是金发。",
      "audio": "audio/s10.m4a",
      "audioSlow": "audio/s10-slow.m4a"
    },
    {
      "id": "s11",
      "es": "¿Adónde van ahora y qué van a hacer? — Van a la facultad.",
      "zh": "他们现在去哪里，要做什么？——去学院。",
      "audio": "audio/s11.m4a",
      "audioSlow": "audio/s11-slow.m4a"
    },
    {
      "id": "s12",
      "es": "¿Con quién está en el mercado Ema? — Está con su hermana Lucía.",
      "zh": "埃玛和谁在市场？——和她妹妹露西亚。",
      "audio": "audio/s12.m4a",
      "audioSlow": "audio/s12-slow.m4a"
    }
  ]
}
