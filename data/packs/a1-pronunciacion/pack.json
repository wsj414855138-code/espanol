  "letters": [
    {
      "id": "x1",
      "letter": "b",
      "tts": "be",
      "group": "b/v",
      "tip": "双唇闭合后气流冲开，声带振动（浊音）；别读成中文\"杯\"",
      "rep": "bebé",
      "letterAudio": "audio/x1.m4a",
      "repAudio": "audio/v1.m4a"
    },
    {
      "id": "x2",
      "letter": "v",
      "tts": "uve",
      "group": "b/v",
      "tip": "嘴型和发音与 b 完全相同，只是字母不同；不要咬嘴唇（不是英语 v）",
      "rep": "viva",
      "letterAudio": "audio/x2.m4a",
      "repAudio": "audio/v2.m4a"
    },
    {
      "id": "x3",
      "letter": "p",
      "tts": "pe",
      "group": "p",
      "tip": "双唇闭合突然打开、强送气，像轻轻\"泼\"；p 送气，b 声带振动",
      "rep": "paloma",
      "letterAudio": "audio/x3.m4a",
      "repAudio": "audio/v3.m4a"
    },
    {
      "id": "x4",
      "letter": "g",
      "tts": "ge",
      "group": "g",
      "tip": "舌根抬向软腭、声带振动；在 a/o/u 前发浊音\"嘎\"",
      "rep": "gallo",
      "letterAudio": "audio/x4.m4a",
      "repAudio": "audio/v5.m4a"
    },
    {
      "id": "x5",
      "letter": "d",
      "tts": "de",
      "group": "d",
      "tip": "舌尖抵上齿背、声带振动；比中文\"得\"（舌尖抵齿龈）更靠前",
      "rep": "dedo",
      "letterAudio": "audio/x5.m4a",
      "repAudio": "audio/v7.m4a"
    },
    {
      "id": "x6",
      "letter": "a",
      "tts": "a",
      "group": "元音",
      "tip": "嘴张大、舌放平，一个音到底不滑动",
      "rep": "paloma",
      "letterAudio": "audio/x6.m4a",
      "repAudio": "audio/v3.m4a"
    },
    {
      "id": "x7",
      "letter": "e",
      "tts": "e",
      "group": "元音",
      "tip": "嘴角向两边咧开像微笑；不要滑成\"诶伊\"",
      "rep": "dedo",
      "letterAudio": "audio/x7.m4a",
      "repAudio": "audio/v7.m4a"
    },
    {
      "id": "x8",
      "letter": "i",
      "tts": "i",
      "group": "元音",
      "tip": "短促清亮；不要拖长滑成\"爱\"",
      "rep": "día",
      "letterAudio": "audio/x8.m4a",
      "repAudio": "audio/v8.m4a"
    },
    {
      "id": "x9",
      "letter": "o",
      "tts": "o",
      "group": "元音",
