  "sentences": [
    {
      "id": "s1",
      "es": "En la sala hay una mesa y dos sofás.",
      "zh": "客厅里有一张桌子和两个沙发。",
      "audio": "audio/s1.m4a",
      "audioSlow": "audio/s1-slow.m4a"
    },
    {
      "id": "s2",
      "es": "En mi casa hay una sala, una cocina y tres habitaciones.",
      "zh": "我家有一个客厅、一个厨房和三个房间。",
      "audio": "audio/s2.m4a",
      "audioSlow": "audio/s2-slow.m4a"
    },
    {
      "id": "s3",
      "es": "¿Dónde estás? — Estoy en el jardín.",
      "zh": "你在哪里？——我在花园里。",
      "audio": "audio/s3.m4a",
      "audioSlow": "audio/s3-slow.m4a"
    },
    {
      "id": "s4",
      "es": "Tengo cinco libros.",
      "zh": "我有五本书。",
      "audio": "audio/s4.m4a",
      "audioSlow": "audio/s4-slow.m4a"
    },
    {
      "id": "s5",
      "es": "¿Tienes hermanos? — Sí, tengo tres hermanos.",
      "zh": "你有兄弟姐妹吗？——有，我有三个。",
      "audio": "audio/s5.m4a",
      "audioSlow": "audio/s5-slow.m4a"
    },
    {
      "id": "s6",
      "es": "El Titicaca es un lago muy grande.",
      "zh": "的的喀喀湖是一个很大的湖。",
      "audio": "audio/s6.m4a",
      "audioSlow": "audio/s6-slow.m4a"
    },
    {
      "id": "s7",
      "es": "La madre de Ana se llama Ángela.",
      "zh": "安娜的妈妈叫安赫拉。",
      "audio": "audio/s7.m4a",
      "audioSlow": "audio/s7-slow.m4a"
    },
    {
      "id": "s8",
      "es": "Una chaqueta roja.",
      "zh": "一件红色外套。",
      "audio": "audio/s8.m4a",
      "audioSlow": "audio/s8-slow.m4a"
    }
