  "cards": [
    {
      "id": "y1",
      "step": 1,
      "type": "规则",
      "title": "分音节①：辅音跟元音走",
      "tip": "元音可以自成音节；一个辅音跟后面的元音合成音节。me-sa、mi-ma、a-é-re-o",
      "mat": [
        "mesa",
        "aéreo"
      ],
      "matAudio": [
        "audio/y1-1.m4a",
        "audio/y1-2.m4a"
      ]
    },
    {
      "id": "y2",
      "step": 2,
      "type": "规则",
      "title": "分音节②：辅音在两个元音之间",
      "tip": "跟后面的元音走。a-mi-go、e-sa、to-ma",
      "mat": [
        "amigo",
        "esa"
      ],
      "matAudio": [
        "audio/y2-1.m4a",
        "audio/y2-2.m4a"
      ]
    },
    {
      "id": "y3",
      "step": 3,
      "type": "规则",
      "title": "分音节③：两个辅音分开走",
      "tip": "相邻两个辅音（词首除外）分属前后音节；但辅音连缀（pl/br/tr…）不可拆，跟后面元音走。es-tu-dian-te、gus-to",
      "mat": [
        "estudiante",
        "gusto"
      ],
      "matAudio": [
        "audio/y3-1.m4a",
        "audio/y3-2.m4a"
      ]
    },
    {
      "id": "y4",
      "step": 4,
      "type": "规则",
      "title": "分音节④：二重元音不拆",
      "tip": "二重元音（ai/ei/oi/au…和 ia/ie/ue…）和前面辅音构成一个音节。bue-no、tam-bién、es-tu-dia",
      "mat": [
        "bueno",
        "estudia"
      ],
      "matAudio": [
        "audio/y4-1.m4a",
        "audio/y4-2.m4a"
      ]
    },
    {
      "id": "y5",
      "step": 5,
      "type": "规则",
      "title": "重音①：词尾是元音、n 或 s",
      "tip": "重音落在倒数第二个音节。me-sa、a-mi-go、so-pa、chi-nos",
      "mat": [
        "mesa",
        "chino"
      ],
      "matAudio": [
        "audio/y5-1.m4a",
        "audio/y5-2.m4a"
      ]
    },
    {
      "id": "y6",
      "step": 6,
      "type": "规则",
      "title": "重音②：词尾是其他辅音",
      "tip": "重音落在最后一个音节。us-ted、fe-liz、pa-pel、ciu-dad、co-mer",
      "mat": [
        "usted",
        "feliz",
        "papel"
      ],
      "matAudio": [
        "audio/y6-1.m4a",
        "audio/y6-2.m4a",
        "audio/y6-3.m4a"
      ]
    },
    {
      "id": "y7",
      "step": 7,
      "type": "规则",
      "title": "重音③：重音符号说了算",
      "tip": "打破上面两条的词必须标重音符号：papá（变末音节）、música（倒二）、geografía（倒三）",
      "mat": [
        "papá",
        "música",
        "geografía"
      ],
      "matAudio": [
        "audio/y7-1.m4a",
        "audio/y7-2.m4a",
        "audio/y7-3.m4a"
      ]
    },
    {
      "id": "y8",
      "step": 8,
      "type": "规则",
      "title": "重音④：二重元音里重音落强元音",
      "tip": "强元音 a/e/o，弱元音 i/u。重音在二重元音上时落在强元音：es-TU-dia、tam-BIÉN",
      "mat": [
        "estudia",
        "también"
      ],
      "matAudio": [
        "audio/y8-1.m4a",
        "audio/y8-2.m4a"
      ]
    },
    {
      "id": "y9",
      "step": 9,
      "type": "规则",
      "title": "总结：拆音节三步法",
      "tip": "①二重元音先圈住不拆 ②辅音连缀圈住不拆 ③剩下的辅音跟右边元音走。拆完音节，重音按三条规则落位",
      "mat": [
        "estudiante"
      ],
      "matAudio": [
        "audio/y9-1.m4a"
      ]
    }
  ],
