  "sentences": [
    {
      "id": "s1",
      "es": "¿Quién es él? — Él es Pepe.",
      "zh": "他是谁？——他是佩佩。",
      "audio": "audio/s1.m4a",
      "audioSlow": "audio/s1-slow.m4a"
    },
    {
      "id": "s2",
      "es": "¿Es Pepe chino? — No, Pepe no es chino. Pepe es chileno.",
      "zh": "佩佩是中国人吗？——不，佩佩不是中国人，佩佩是智利人。",
      "audio": "audio/s2.m4a",
      "audioSlow": "audio/s2-slow.m4a"
    },
    {
      "id": "s3",
      "es": "Ella se llama Ana. Ana es panameña.",
      "zh": "她叫安娜。安娜是巴拿马人。",
      "audio": "audio/s3.m4a",
      "audioSlow": "audio/s3-slow.m4a"
    },
    {
      "id": "s4",
      "es": "Ella es Li Xin. Es china.",
      "zh": "她是李欣。她是中国人。",
      "audio": "audio/s4.m4a",
      "audioSlow": "audio/s4-slow.m4a"
    },
    {
      "id": "s5",
      "es": "Paco y Pepe son amigos.",
      "zh": "帕科和佩佩是朋友。",
      "audio": "audio/s5.m4a",
      "audioSlow": "audio/s5-slow.m4a"
    },
    {
      "id": "s6",
      "es": "Ana y Li Xin son amigas.",
      "zh": "安娜和李欣是朋友。",
      "audio": "audio/s6.m4a",
      "audioSlow": "audio/s6-slow.m4a"
    },
    {
      "id": "s7",
      "es": "¿Es él Paco? — Sí, él es Paco.",
      "zh": "他是帕科吗？——是的，他是帕科。",
      "audio": "audio/s7.m4a",
      "audioSlow": "audio/s7-slow.m4a"
    },
    {
      "id": "s8",
      "es": "¿Es ella Ema? — No, ella no es Ema, es Ana.",
      "zh": "她是埃玛吗？——不，她不是埃玛，是安娜。",
      "audio": "audio/s8.m4a",
      "audioSlow": "audio/s8-slow.m4a"
    },
    {
      "id": "s9",
      "es": "¿Son amigos Pepe y Paco? — Sí, ellos son amigos.",
      "zh": "佩佩和帕科是朋友吗？——是的，他们是朋友。",
      "audio": "audio/s9.m4a",
      "audioSlow": "audio/s9-slow.m4a"
    },
    {
      "id": "s10",
      "es": "¿Quién es ella? — Ella es Ana.",
      "zh": "她是谁？——她是安娜。",
      "audio": "audio/s10.m4a",
      "audioSlow": "audio/s10-slow.m4a"
    }
  ]
