  "sentences": [
    {
      "id": "s1",
      "es": "Ema, la esposa de Paco, es funcionaria.",
      "zh": "埃玛，帕科的妻子，是公务员。",
      "audio": "audio/s1.m4a",
      "audioSlow": "audio/s1-slow.m4a"
    },
    {
      "id": "s2",
      "es": "Es una señora amable. Su oficina es pequeña.",
      "zh": "她是一位和蔼的女士。她的办公室很小。",
      "audio": "audio/s2.m4a",
      "audioSlow": "audio/s2-slow.m4a"
    },
    {
      "id": "s3",
      "es": "La casa de Paco y Ema es bonita.",
      "zh": "帕科和埃玛的房子很好看。",
      "audio": "audio/s3.m4a",
      "audioSlow": "audio/s3-slow.m4a"
    },
    {
      "id": "s4",
      "es": "En ella hay una mesa, una cama, cuatro sillas y un estante.",
      "zh": "里面有一张桌子、一张床、四把椅子和一个书架。",
      "audio": "audio/s4.m4a",
      "audioSlow": "audio/s4-slow.m4a"
    },
    {
      "id": "s5",
      "es": "En el estante hay muchos libros nuevos e interesantes.",
      "zh": "书架上有许多新的、有趣的书。",
      "audio": "audio/s5.m4a",
      "audioSlow": "audio/s5-slow.m4a"
    },
    {
      "id": "s6",
      "es": "Ahora Paco está en su habitación. Está mal.",
      "zh": "现在帕科在他的房间里。他身体不舒服。",
      "audio": "audio/s6.m4a",
      "audioSlow": "audio/s6-slow.m4a"
    },
    {
      "id": "s7",
      "es": "La escuela de Paco es grande.",
      "zh": "帕科的学校很大。",
      "audio": "audio/s7.m4a",
      "audioSlow": "audio/s7-slow.m4a"
    },
    {
      "id": "s8",
      "es": "¿Cómo se llama la esposa de Paco? — Ella se llama Ema.",
      "zh": "帕科的妻子叫什么？——她叫埃玛。",
      "audio": "audio/s8.m4a",
      "audioSlow": "audio/s8-slow.m4a"
    },
    {
      "id": "s9",
      "es": "¿Es grande la oficina de Ema? — No, es pequeña.",
      "zh": "埃玛的办公室大吗？——不大，很小。",
      "audio": "audio/s9.m4a",
      "audioSlow": "audio/s9-slow.m4a"
    },
    {
      "id": "s10",
      "es": "¿Cómo es la casa de Paco y Ema? — Su casa es bonita.",
      "zh": "帕科和埃玛的房子怎么样？——很好看。",
      "audio": "audio/s10.m4a",
      "audioSlow": "audio/s10-slow.m4a"
    },
    {
      "id": "s11",
      "es": "¿Dónde está Paco? — Paco está en su habitación.",
      "zh": "帕科在哪里？——帕科在他的房间里。",
      "audio": "audio/s11.m4a",
      "audioSlow": "audio/s11-slow.m4a"
    },
    {
      "id": "s12",
      "es": "¿Qué hay en el estante? — Hay libros, periódicos y revistas.",
      "zh": "书架上有什么？——有书、报纸和杂志。",
      "audio": "audio/s12.m4a",
      "audioSlow": "audio/s12-slow.m4a"
    }
  ]
