  "sentences": [
    {
      "id": "s1",
      "es": "Ella es Lucía. Es cantante.",
      "zh": "她是露西亚。她是歌手。",
      "audio": "audio/s1.m4a",
      "audioSlow": "audio/s1-slow.m4a"
    },
    {
      "id": "s2",
      "es": "Estos son Manolo y Ema. Manolo es médico.",
      "zh": "这两位是马诺罗和埃玛。马诺罗是医生。",
      "audio": "audio/s2.m4a",
      "audioSlow": "audio/s2-slow.m4a"
    },
    {
      "id": "s3",
      "es": "Ema no es médica, es enfermera.",
      "zh": "埃玛不是医生，是护士。",
      "audio": "audio/s3.m4a",
      "audioSlow": "audio/s3-slow.m4a"
    },
    {
      "id": "s4",
      "es": "Es esposa de Manolo y madre de Pepe y Paco.",
      "zh": "她是马诺罗的妻子，佩佩和帕科的母亲。",
      "audio": "audio/s4.m4a",
      "audioSlow": "audio/s4-slow.m4a"
    },
    {
      "id": "s5",
      "es": "¿Quién es Paco? — Éste es Paco.",
      "zh": "帕科是谁？——这位是帕科。",
      "audio": "audio/s5.m4a",
      "audioSlow": "audio/s5-slow.m4a"
    },
    {
      "id": "s6",
      "es": "¿Qué es Paco? — Paco es estudiante.",
      "zh": "帕科是做什么的？——帕科是学生。",
      "audio": "audio/s6.m4a",
      "audioSlow": "audio/s6-slow.m4a"
    },
    {
      "id": "s7",
      "es": "¿Es Pepe padre de Paco? — No, es su hermano.",
      "zh": "佩佩是帕科的父亲吗？——不，是他的兄弟。",
      "audio": "audio/s7.m4a",
      "audioSlow": "audio/s7-slow.m4a"
    },
    {
      "id": "s8",
      "es": "¿Quiénes son ellos? — Son Manolo y Ema.",
      "zh": "他们是谁？——是马诺罗和埃玛。",
      "audio": "audio/s8.m4a",
      "audioSlow": "audio/s8-slow.m4a"
    },
    {
      "id": "s9",
      "es": "¿Es Ema hermana de Manolo? — No, es su esposa.",
      "zh": "埃玛是马诺罗的姐妹吗？——不，是他的妻子。",
      "audio": "audio/s9.m4a",
      "audioSlow": "audio/s9-slow.m4a"
    },
    {
      "id": "s10",
      "es": "¿Qué eres tú? — Soy médica.",
      "zh": "你是做什么的？——我是医生。",
      "audio": "audio/s10.m4a",
      "audioSlow": "audio/s10-slow.m4a"
    },
    {
      "id": "s11",
      "es": "Soy amiga de Lucía y Ema.",
      "zh": "我是露西亚和埃玛的朋友。",
      "audio": "audio/s11.m4a",
      "audioSlow": "audio/s11-slow.m4a"
    }
  ]
