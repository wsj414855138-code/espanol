  "sentences": [
    {
      "id": "s1",
      "es": "Esta es la foto de mi familia. Somos siete.",
      "zh": "这是我们家的照片。我们家有七口人。",
      "audio": "audio/s1.m4a",
      "audioSlow": "audio/s1-slow.m4a"
    },
    {
      "id": "s2",
      "es": "Estamos en la habitación de mi hermana.",
      "zh": "我们在姐姐的房间里。",
      "audio": "audio/s2.m4a",
      "audioSlow": "audio/s2-slow.m4a"
    },
    {
      "id": "s3",
      "es": "La habitación está limpia y ordenada.",
      "zh": "房间干净又整齐。",
      "audio": "audio/s3.m4a",
      "audioSlow": "audio/s3-slow.m4a"
    },
    {
      "id": "s4",
      "es": "Mi hermana es cantante. Tiene veinticinco años.",
      "zh": "我姐姐是歌手。她二十五岁。",
      "audio": "audio/s4.m4a",
      "audioSlow": "audio/s4-slow.m4a"
    },
    {
      "id": "s5",
      "es": "El hombre moreno es mi padre. Es taxista.",
      "zh": "那位皮肤黝黑的男人是我爸爸。他是出租车司机。",
      "audio": "audio/s5.m4a",
      "audioSlow": "audio/s5-slow.m4a"
    },
    {
      "id": "s6",
      "es": "Es alto, fuerte y alegre.",
      "zh": "他个子高、身体强壮又开朗。",
      "audio": "audio/s6.m4a",
      "audioSlow": "audio/s6-slow.m4a"
    },
    {
      "id": "s7",
      "es": "La mujer rubia y de blusa roja es mi madre.",
      "zh": "那位金发、穿红衬衫的女士是我妈妈。",
      "audio": "audio/s7.m4a",
      "audioSlow": "audio/s7-slow.m4a"
    },
    {
      "id": "s8",
      "es": "Es peluquera. Tiene también cincuenta años.",
      "zh": "她是理发师。她也五十岁。",
      "audio": "audio/s8.m4a",
      "audioSlow": "audio/s8-slow.m4a"
    },
    {
      "id": "s9",
      "es": "¿Cuántos sois en tu familia? — Somos siete.",
      "zh": "你家有几口人？——七口。",
      "audio": "audio/s9.m4a",
      "audioSlow": "audio/s9-slow.m4a"
    },
    {
      "id": "s10",
      "es": "¿Cuántos hermanos tienes? — Tengo dos hermanos.",
      "zh": "你有几个兄弟姐妹？——我有两个兄弟。",
      "audio": "audio/s10.m4a",
      "audioSlow": "audio/s10-slow.m4a"
    },
    {
      "id": "s11",
      "es": "¿Cómo está la habitación de tu hermana? — Está limpia y ordenada.",
      "zh": "你姐姐的房间怎么样？——干净又整齐。",
      "audio": "audio/s11.m4a",
      "audioSlow": "audio/s11-slow.m4a"
    },
    {
      "id": "s12",
      "es": "¿Son mayores tus abuelos? — Sí, tienen ochenta años.",
      "zh": "你祖父母年纪大吗？——是的，他们八十岁了。",
      "audio": "audio/s12.m4a",
      "audioSlow": "audio/s12-slow.m4a"
    }
  ]
