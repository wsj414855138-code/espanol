  "sentences": [
    {
      "id": "s1",
      "es": "¿De qué color es el hipopótamo? — Es gris.",
      "zh": "河马是什么颜色？——是灰色。",
      "audio": "audio/s1.m4a",
      "audioSlow": "audio/s1-slow.m4a"
    },
    {
      "id": "s2",
      "es": "¿De qué color son los zapatos? — Son negros.",
      "zh": "鞋子是什么颜色？——是黑色。",
      "audio": "audio/s2.m4a",
      "audioSlow": "audio/s2-slow.m4a"
    },
    {
      "id": "s3",
      "es": "Los plátanos son amarillos.",
      "zh": "香蕉是黄色的。",
