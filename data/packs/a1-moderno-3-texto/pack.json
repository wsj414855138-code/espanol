  "sentences": [
    {
      "id": "s1",
      "es": "Ésta es mi casa.",
      "zh": "这是我的家。",
      "audio": "audio/s1.m4a",
      "audioSlow": "audio/s1-slow.m4a"
    },
    {
      "id": "s2",
      "es": "En ella hay una sala, una cocina y tres dormitorios.",
      "zh": "里面有一个客厅、一个厨房和三个卧室。",
      "audio": "audio/s2.m4a",
      "audioSlow": "audio/s2-slow.m4a"
    },
    {
      "id": "s3",
      "es": "En la sala hay una mesa y dos sofás.",
      "zh": "客厅里有一张桌子和两个沙发。",
      "audio": "audio/s3.m4a",
      "audioSlow": "audio/s3-slow.m4a"
    },
    {
      "id": "s4",
      "es": "Este dormitorio es de mis hijos.",
      "zh": "这个卧室是我孩子们的。",
      "audio": "audio/s4.m4a",
      "audioSlow": "audio/s4-slow.m4a"
    },
    {
      "id": "s5",
      "es": "Mi esposa es funcionaria.",
      "zh": "我妻子是公务员。",
      "audio": "audio/s5.m4a",
      "audioSlow": "audio/s5-slow.m4a"
    },
    {
      "id": "s6",
      "es": "Su oficina está en el centro de la ciudad.",
      "zh": "她的办公室在市中心。",
      "audio": "audio/s6.m4a",
      "audioSlow": "audio/s6-slow.m4a"
    },
    {
      "id": "s7",
      "es": "Nuestra fábrica está en las afueras de la ciudad.",
      "zh": "我们的工厂在城郊。",
      "audio": "audio/s7.m4a",
      "audioSlow": "audio/s7-slow.m4a"
    },
    {
      "id": "s8",
      "es": "¿Es ésta tu casa? — Sí, ésta es mi casa.",
      "zh": "这是你的家吗？——是的，这是我的家。",
      "audio": "audio/s8.m4a",
      "audioSlow": "audio/s8-slow.m4a"
    },
    {
      "id": "s9",
      "es": "¿Qué hay en la sala? — En ella hay una mesa y dos sofás.",
      "zh": "客厅里有什么？——有一张桌子和两个沙发。",
      "audio": "audio/s9.m4a",
      "audioSlow": "audio/s9-slow.m4a"
    },
    {
      "id": "s10",
      "es": "¿Dónde está la oficina de tu esposa? — Está en el centro de la ciudad.",
      "zh": "你妻子的办公室在哪？——在市中心。",
      "audio": "audio/s10.m4a",
      "audioSlow": "audio/s10-slow.m4a"
    },
    {
      "id": "s11",
      "es": "¿Dónde está vuestra fábrica? — Está en las afueras de la ciudad.",
      "zh": "你们的工厂在哪？——在城郊。",
      "audio": "audio/s11.m4a",
      "audioSlow": "audio/s11-slow.m4a"
    },
    {
      "id": "s12",
      "es": "¿Hay muchos empleados en la fábrica? — Sí, hay muchos.",
      "zh": "工厂里有很多雇员吗？——是的，很多。",
      "audio": "audio/s12.m4a",
      "audioSlow": "audio/s12-slow.m4a"
    }
  ]
